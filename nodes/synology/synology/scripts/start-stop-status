#!/bin/sh
set -eu

PKGDEST="${SYNOPKG_PKGDEST:?}"
PKGVAR="${SYNOPKG_PKGVAR:?}"
BIN="$PKGDEST/bin/executor-node"
CONFIG="$PKGVAR/config.json"
PIDFILE="$PKGVAR/executor-node.pid"
LOGFILE="$PKGVAR/executor-node.log"

read_pid() {
  [ -f "$PIDFILE" ] || return 1
  pid="$(cat "$PIDFILE" 2>/dev/null || true)"
  case "$pid" in
    ''|*[!0-9]*) return 1 ;;
  esac
  printf '%s' "$pid"
}

is_running() {
  pid="$(read_pid)" || return 1
  kill -0 "$pid" 2>/dev/null
}

case "${1:-}" in
  prestart|prestop)
    exit 0
    ;;
  start)
    if is_running; then
      exit 0
    fi
    rm -f "$PIDFILE"
    [ -x "$BIN" ] || exit 1
    [ -f "$CONFIG" ] || exit 1
    umask 077
    nohup "$BIN" --config "$CONFIG" >>"$LOGFILE" 2>&1 </dev/null &
    pid=$!
    printf '%s\n' "$pid" > "$PIDFILE"
    sleep 0.1
    if kill -0 "$pid" 2>/dev/null; then
      exit 0
    fi
    rm -f "$PIDFILE"
    exit 1
    ;;
  stop)
    if ! is_running; then
      rm -f "$PIDFILE"
      exit 0
    fi
    pid="$(read_pid)"
    kill "$pid" 2>/dev/null || true
    attempts=0
    while kill -0 "$pid" 2>/dev/null; do
      attempts=$((attempts + 1))
      [ "$attempts" -lt 100 ] || exit 1
      sleep 0.1
    done
    rm -f "$PIDFILE"
    exit 0
    ;;
  status)
    if is_running; then
      exit 0
    fi
    if [ -f "$PIDFILE" ]; then
      exit 1
    fi
    exit 3
    ;;
  *)
    exit 4
    ;;
esac
