PORT=8787
HOST=127.0.0.1
EXECUTOR_CLIENT_TOKEN=replace-with-long-random-client-token
EXECUTOR_DEVICE_TOKEN=replace-with-long-random-device-token
# Optional server-side per-device binding. Mapped IDs require their mapped token even when a shared token exists.
EXECUTOR_DEVICE_TOKENS_JSON=
# Recommended for live enrollment: JSON object file re-read on each device hello.
EXECUTOR_DEVICE_TOKENS_FILE=
# Separate device ingress. TLS termination should sit in front of this listener for remote laptops.
EXECUTOR_DEVICE_HOST=127.0.0.1
EXECUTOR_DEVICE_PORT=8788
# Operator-facing external base URL used when generating enrollment commands.
EXECUTOR_DEVICE_PUBLIC_URL=https://devices.example.com
# Optional local agent credential when the server uses map-only per-device credentials.
EXECUTOR_DEVICE_AGENT_TOKEN=
EXECUTOR_DEFAULT_DEVICE=
EXECUTOR_SERVICE_URL=https://executor.example.com
# Optional PEM CA used by direct WSS device ingress.
EXECUTOR_DEVICE_CA_FILE=
EXECUTOR_DEVICE_ID=workstation
EXECUTOR_INSTALL_ROOT=C:\ProgramData\Executor\DesktopCommanderMCP
EXECUTOR_EXECUTION_CAPACITY=8
EXECUTOR_LOGIC_CAPACITY=64
EXECUTOR_ALLOWED_ORIGINS=https://chatgpt.com
EXECUTOR_TRUSTED_MANIFEST_SHA256=replace-with-sha256-from-trusted-install-handoff
# Optional durable JSONL lifecycle evidence
EXECUTOR_EXECUTION_EVENT_FILE=./data/execution-events.jsonl

# Private tunnel runtime; keep real values out of Git.
EXECUTOR_TUNNEL_ID=
EXECUTOR_TUNNEL_API_SECRET=
